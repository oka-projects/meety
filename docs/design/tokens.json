  "typography": {
    "family": "SF Pro (system). Use Font.system(...) and .monospacedDigit() for times.",
    "mono": "SF Mono (system monospaced) for timestamps, percentages and export previews",
    "scale": {
      "windowTitle": {
        "size": 22,
        "weight": "semibold",
        "tracking": -0.4
      },
      "sheetTitle": {
        "size": 24,
        "weight": "semibold",
        "tracking": -0.4
      },
      "stateTitle": {
        "size": 20,
        "weight": "semibold",
        "tracking": -0.3
      },
      "sectionTitle": {
        "size": 17,
        "weight": "semibold"
      },
      "headline": {
        "size": 13,
        "weight": "semibold"
      },
      "body": {
        "size": 13,
        "weight": "regular"
      },
      "transcript": {
        "size": 14,
        "weight": "regular",
        "lineHeight": 1.55
      },
      "callout": {
        "size": 12,
        "weight": "regular"
      },
      "caption": {
        "size": 11,
        "weight": "regular"
      },
      "sectionLabel": {
        "size": 11,
        "weight": "semibold",
        "uppercase": true,
        "tracking": 0.5
      },
      "timeInline": {
        "size": 13,
        "weight": "regular",
        "mono": true,
        "tabularDigits": true
      },
      "timeBlock": {
        "size": 17,
        "weight": "medium",
        "mono": true,
        "tabularDigits": true
      },
      "timeBig": {
        "size": 44,
        "weight": "light",
        "mono": true,
        "tabularDigits": true
      }
    }
  },
  "radius": {
    "control": 6,
    "field": 7,
    "row": 7,
    "card": 10,
    "window": 10,
    "sheet": 12,
    "popover": 10,
    "hero": 28,
    "pill": 999,
    "progress": 3
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 28,
    "xxl": 36
  },
  "size": {
    "toolbarHeight": 52,
    "sidebarWidth": {
      "default": 300,
      "min": 260,
      "max": 420
    },
    "controlHeight": 28,
    "controlHeightLarge": 36,
    "controlHeightSmall": 24,
    "recordButton": 44,
    "playerButton": 32,
    "chipHeight": 24,
    "meetingRowPadding": "7 10",
    "contentPadding": 28,
    "sheetPadding": {
      "welcome": "36 40 20",
      "export": "24 24 18"
    },
    "window": {
      "default": "1100x700",
      "min": "820x520"
    },
    "welcomeSheet": "560x460",
    "exportSheet": "480x560",
    "settingsWindow": "560 wide",
    "heroIcon": {
      "welcome": 84,
      "emptyState": 96
    },
    "progressBarHeight": 6,
    "levelMeterHeight": 4
  },
  "shadow": {
    "control": "0 1px 1px rgba(0,0,0,0.06) light / 0 1px 1px rgba(0,0,0,0.30) dark",
    "popover": "0 8px 28px rgba(0,0,0,0.18) + 1px hairline light / 0 8px 28px rgba(0,0,0,0.50) dark",
    "segmentedThumb": "0 1px 2px rgba(0,0,0,0.18)"
  },
  "motion": {
    "recordingPulse": "opacity 1 to 0.35, 1.6 s ease-in-out, repeat",
    "recordingWave": "scaleY 0.45 to 1, 1.2 s ease-in-out, repeat, staggered 0.1 to 0.5 s per bar",
    "spinner": "1 s linear rotation"
  },
  "sfSymbols": {
    "record": "record.circle.fill / stop.fill",
    "menuBarIdle": "waveform (template)",
    "menuBarRecording": "record.circle.fill (red, not template)",
