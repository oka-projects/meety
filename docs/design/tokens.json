{
  "name": "Meety design tokens",
  "version": "1.0",
  "notes": "Hex colors with light and dark variants. 'fill' colors are meant for backgrounds under white text; 'text' variants are for text and icons on the window background. Alpha tints are expressed as rgba so they adapt to any background.",

  "color": {
    "accent": {
      "fill":  { "light": "#146C66", "dark": "#1F7F78" },
      "text":  { "light": "#146C66", "dark": "#5FC8C0" },
      "tint":  { "light": "rgba(20,108,102,0.12)", "dark": "rgba(95,200,192,0.14)" },
      "onAccent": "#FFFFFF"
    },
    "background": {
      "window":   { "light": "#F4F6F6", "dark": "#1E2424" },
      "sidebar":  { "light": "#ECF0F0", "dark": "#262C2C" },
      "content":  { "light": "#FFFFFF", "dark": "#1A1F1F" },
      "elevated": { "light": "#FFFFFF", "dark": "#2A3131" },
      "control":  { "light": "#FFFFFF", "dark": "#343B3B" },
      "fill":     { "light": "rgba(0,0,0,0.05)",  "dark": "rgba(255,255,255,0.07)" },
      "fillStrong": { "light": "rgba(0,0,0,0.10)", "dark": "rgba(255,255,255,0.14)" },
      "hover":    { "light": "rgba(0,0,0,0.05)",  "dark": "rgba(255,255,255,0.06)" }
    },
    "text": {
      "primary":   { "light": "#1A2121", "dark": "#ECF0F0" },
      "secondary": { "light": "#5B6868", "dark": "#A6B1B1" },
      "tertiary":  { "light": "#5F6C6C", "dark": "#8B9797" }
    },
    "border": {
      "separator":  { "light": "rgba(0,0,0,0.09)", "dark": "rgba(255,255,255,0.09)" },
      "strong":     { "light": "rgba(0,0,0,0.14)", "dark": "rgba(255,255,255,0.16)" },
      "control":    { "light": "rgba(0,0,0,0.13)", "dark": "rgba(255,255,255,0.10)" }
    },
    "status": {
      "recordFill": { "light": "#D43A30", "dark": "#D43A30" },
      "recordText": { "light": "#C7342B", "dark": "#FF6259" },
      "recordTint": { "light": "rgba(212,58,48,0.12)", "dark": "rgba(255,98,89,0.16)" },
      "success":    { "light": "#22743B", "dark": "#5BCB7A" },
      "successTint":{ "light": "rgba(34,116,59,0.12)", "dark": "rgba(91,203,122,0.14)" },
      "warning":    { "light": "#9A5A00", "dark": "#F0B458" },
      "warningTint":{ "light": "rgba(154,90,0,0.10)", "dark": "rgba(240,180,88,0.12)" }
    },
    "speakers": [
      { "index": 1, "role": "You (always the accent)", "light": "#146C66", "dark": "#5FC8C0" },
      { "index": 2, "role": "Participant / Speaker",   "light": "#4453C8", "dark": "#9AA6FF" },
      { "index": 3, "role": "Participant / Speaker",   "light": "#8F5A00", "dark": "#E3AC3F" },
      { "index": 4, "role": "Participant / Speaker",   "light": "#8A3C9E", "dark": "#D193E3" },
      { "index": 5, "role": "Participant / Speaker",   "light": "#BC3F24", "dark": "#F5907A" },
      { "index": 6, "role": "Participant / Speaker",   "light": "#4A7A1A", "dark": "#A4D25E" },
      { "index": 7, "role": "Participant / Speaker",   "light": "#2767A3", "dark": "#80BDF0" },
      { "index": 8, "role": "Participant / Speaker",   "light": "#B0346A", "dark": "#F094BC" }
    ],
    "icon": {
      "gradientTop": "#2C8E86",
      "gradientBottom": "#0C4A46",
      "bubble": "#FFFFFF",
      "wave": "#146C66"
    }
  },

  "typography": {
    "family": "SF Pro (system). Use Font.system(...) and .monospacedDigit() for times.",
    "mono": "SF Mono (system monospaced) for timestamps, percentages and export previews",
    "scale": {
      "windowTitle":   { "size": 22, "weight": "semibold", "tracking": -0.4 },
      "sheetTitle":    { "size": 24, "weight": "semibold", "tracking": -0.4 },
      "stateTitle":    { "size": 20, "weight": "semibold", "tracking": -0.3 },
      "sectionTitle":  { "size": 17, "weight": "semibold" },
      "headline":      { "size": 13, "weight": "semibold" },
      "body":          { "size": 13, "weight": "regular" },
      "transcript":    { "size": 14, "weight": "regular", "lineHeight": 1.55 },
      "callout":       { "size": 12, "weight": "regular" },
      "caption":       { "size": 11, "weight": "regular" },
      "sectionLabel":  { "size": 11, "weight": "semibold", "uppercase": true, "tracking": 0.5 },
      "timeInline":    { "size": 13, "weight": "regular", "mono": true, "tabularDigits": true },
      "timeBlock":     { "size": 17, "weight": "medium",  "mono": true, "tabularDigits": true },
      "timeBig":       { "size": 44, "weight": "light",   "mono": true, "tabularDigits": true }
    }
  },

  "radius": {
    "control": 6,
    "field": 7,
    "row": 7,
    "card": 10,
    "window": 10,
    "sheet": 12,
    "popover": 10,
    "hero": 28,
    "pill": 999,
    "progress": 3
  },

  "spacing": {
    "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 28, "xxl": 36
  },

  "size": {
    "toolbarHeight": 52,
    "sidebarWidth": { "default": 300, "min": 260, "max": 420 },
    "controlHeight": 28,
    "controlHeightLarge": 36,
    "controlHeightSmall": 24,
    "recordButton": 44,
    "playerButton": 32,
    "chipHeight": 24,
    "meetingRowPadding": "7 10",
    "contentPadding": 28,
    "sheetPadding": { "welcome": "36 40 20", "export": "24 24 18" },
    "window": { "default": "1100x700", "min": "820x520" },
    "welcomeSheet": "560x460",
    "exportSheet": "480x560",
    "settingsWindow": "560 wide",
    "heroIcon": { "welcome": 84, "emptyState": 96 },
    "progressBarHeight": 6,
    "levelMeterHeight": 4
  },

  "shadow": {
    "control": "0 1px 1px rgba(0,0,0,0.06) light / 0 1px 1px rgba(0,0,0,0.30) dark",
    "popover": "0 8px 28px rgba(0,0,0,0.18) + 1px hairline light / 0 8px 28px rgba(0,0,0,0.50) dark",
    "segmentedThumb": "0 1px 2px rgba(0,0,0,0.18)"
  },

  "motion": {
    "recordingPulse": "opacity 1 to 0.35, 1.6 s ease-in-out, repeat",
    "recordingWave": "scaleY 0.45 to 1, 1.2 s ease-in-out, repeat, staggered 0.1 to 0.5 s per bar",
    "spinner": "1 s linear rotation"
  },

  "sfSymbols": {
    "record": "record.circle.fill / stop.fill",
    "menuBarIdle": "waveform (template)",
    "menuBarRecording": "record.circle.fill (red, not template)",
    "import": "square.and.arrow.down",
    "export": "square.and.arrow.up",
    "more": "ellipsis.circle",
    "search": "magnifyingglass",
    "importedFile": "doc",
    "failed": "exclamationmark.triangle.fill",
    "microphone": "mic.fill",
    "systemAudio": "rectangle.inset.filled.and.person.filled",
    "models": "shippingbox",
    "summaries": "text.alignleft",
    "general": "gearshape",
    "about": "info.circle",
    "shortSummary": "text.alignleft",
    "meetingMinutes": "list.clipboard",
    "actionItems": "checklist",
    "customPrompt": "bubble.left",
    "appleIntelligence": "apple.intelligence (macOS 26) or sparkles",
    "localModel": "cpu",
    "cloud": "cloud",
    "apiKey": "key",
    "local": "lock.fill",
    "back15": "gobackward.15",
    "forward15": "goforward.15",
    "play": "play.fill",
    "pause": "pause.fill",
    "copy": "doc.on.doc",
    "delete": "trash",
    "download": "arrow.down.circle",
    "installed": "checkmark.circle.fill",
    "speakerRename": "pencil"
  }
}
