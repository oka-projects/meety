    "Record a meeting or drop a file here": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma reunião ou solte um arquivo aqui"
          }
        }
      }
    },
    "Record your meetings, get a transcript you can search, and a summary you can share. Everything runs on your Mac: your conversations stay with you.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave as suas reuniões, tenha uma transcrição em que dá para buscar e um resumo para compartilhar. Tudo roda no seu Mac: as suas conversas ficam com você."
          }
        }
      }
    },
    "Recording · %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravando · %@"
